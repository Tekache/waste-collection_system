# MongoDB Atlas connection string (backend only, never put this in the frontend)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=waste_collection_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Allowed frontend origin(s), comma separated, no trailing slash.
# Local: http://localhost:5173   Production: your Vercel URL
FRONTEND_URL=http://localhost:5173
# Optional: allow Vercel preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# First administrator, created automatically at startup if the email does not exist yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=System Administrator
